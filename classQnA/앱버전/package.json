{
  "name": "classqna-desktop",
  "productName": "ClassQnA",
  "version": "1.0.0",
  "private": true,
  "description": "수업 질문 대화 앱",
  "main": "desktop/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win portable",
    "test": "node --test ../server/server.test.js ../server/demo.test.js"
  },
  "build": {
    "asar": true,
    "appId": "io.github.nnooww.classqna",
    "win": {
      "target": "portable",
      "icon": "desktop/icon.ico"
    },
    "files": [
      "desktop/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "./afterPack.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  }
}

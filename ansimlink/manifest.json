{
  "manifest_version": 3,
  "name": "안심링크",
  "version": "1.0.0",
  "description": "붙여넣은 링크를 분석하고 결과를 음성으로 안내합니다.",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["clipboardRead"]
}
